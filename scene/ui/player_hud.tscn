[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/player_hud.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/circular_gauge.gd" id="2_gauge"]

[node name="PlayerHUD" type="CanvasLayer"]
layer = 5
script = ExtResource("1_script")

[node name="HUD" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="LeftHUDBox" type="VBoxContainer" parent="HUD"]
layout_mode = 0
offset_left = 24.0
offset_top = 20.0
offset_right = 300.0
offset_bottom = 180.0
theme_override_constants/separation = 12

[node name="GaugesHBox" type="HBoxContainer" parent="HUD/LeftHUDBox"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="HpGauge" type="Control" parent="HUD/LeftHUDBox/GaugesHBox"]
custom_minimum_size = Vector2(92, 92)
layout_mode = 2
size_flags_horizontal = 4
script = ExtResource("2_gauge")
gauge_title = "HP"
fg_color = Color(0.95, 0.2, 0.25, 0.95)
radius = 42.0

[node name="StaminaGauge" type="Control" parent="HUD/LeftHUDBox/GaugesHBox"]
custom_minimum_size = Vector2(92, 92)
layout_mode = 2
size_flags_horizontal = 4
script = ExtResource("2_gauge")
gauge_title = "STAMINA"
fg_color = Color(0.2, 0.75, 1, 0.95)
radius = 42.0

[node name="LivesLabel" type="Label" parent="HUD/LeftHUDBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.85, 0.95)
theme_override_font_sizes/font_size = 15
text = "LIVES: ♥ ♥ ♥"

[node name="GameOverPanel" type="Control" parent="."]
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="DimOverlay" type="ColorRect" parent="GameOverPanel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.06, 0.02, 0.04, 0.88)

[node name="CenterContainer" type="CenterContainer" parent="GameOverPanel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="GameOverPanel/CenterContainer"]
layout_mode = 2
theme_override_constants/separation = 16
